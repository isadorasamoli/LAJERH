rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'isadora.mlima@ufpe.br' || 
          request.auth.token.email.lower() == 'isadora.mlima@ufpe' ||
          request.auth.token.email.lower().matches('^isadora\\.mlima@ufpe.*') ||
          request.auth.token.email.lower() == 'isadorasdml@gmail.com'
        )) || 
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) || 
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isRH == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDiretorio == true ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueRole != null &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueRole.matches('.*(RH|Recursos Humanos|Diretoria|Diretório).*'))
        ))
      );
    }

    function isProjectOwner(data) {
      return isSignedIn() && (
        (data.keys().hasAny(['leaderUid']) && data.leaderUid == request.auth.uid) ||
        (data.keys().hasAny(['responsibleDirectorUid']) && data.responsibleDirectorUid == request.auth.uid)
      );
    }

    function isProjectTeamMember(data) {
      return isSignedIn() &&
        data.keys().hasAny(['teamMemberUids']) &&
        data.teamMemberUids is list &&
        request.auth.uid in data.teamMemberUids;
    }

    function isProjectManager(data) {
      return isProjectOwner(data) || isProjectTeamMember(data);
    }

    function canManageProject(projectId) {
      return isAdmin() || (
        projectId is string &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isProjectManager(get(/databases/$(database)/documents/projects/$(projectId)).data)
      );
    }

    function isRHorSuperAdmin() {
      return isAdmin();
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Validation Blueprint for Response
    function isValidResponse(data) {
      return data.keys().hasAll(['userId', 'email', 'name', 'course', 'leagueRole', 'status'])
        && data.userId is string
        && data.email is string && data.email.size() <= 255
        && data.name is string && data.name.size() <= 255
        && (!data.keys().hasAny(['birthday']) || (data.birthday is string && data.birthday.size() <= 50))
        && data.course is string && data.course.size() <= 255
        && data.period is string && data.period.size() <= 50
        && (!data.keys().hasAny(['collegeFocus']) || data.collegeFocus is number)
        && data.leagueRole is string && data.leagueRole.size() <= 255
        && (!data.keys().hasAny(['leagueFocus']) || data.leagueFocus is number)
        && (!data.keys().hasAny(['weeklyHours']) || (data.weeklyHours is string && data.weeklyHours.size() <= 200))
        && (!data.keys().hasAny(['roleFocus']) || (data.roleFocus is string && data.roleFocus.size() <= 2000))
        && (!data.keys().hasAny(['learningFocus']) || (data.learningFocus is string && data.learningFocus.size() <= 2000))
        && (!data.keys().hasAny(['currentProjects']) || (data.currentProjects is string && data.currentProjects.size() <= 1000))
        && (!data.keys().hasAny(['interestedProjects']) || (data.interestedProjects is string && data.interestedProjects.size() <= 1000))
        && (!data.keys().hasAny(['priority']) || (data.priority is string && data.priority.size() <= 50))
        && (!data.keys().hasAny(['progress']) || data.progress is number)
        && (!data.keys().hasAny(['deadline']) || (data.deadline is string && data.deadline.size() <= 50))
        && (!data.keys().hasAny(['notifications']) || data.notifications is bool)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is number)
        && data.status in ['Ativo', 'Ex-membro']
        && (!data.keys().hasAny(['deletionReason']) || (data.deletionReason is string && data.deletionReason.size() <= 2000))
        && (!data.keys().hasAny(['discordUser']) || (data.discordUser is string && data.discordUser.size() <= 100))
        && (!data.keys().hasAny(['isInProject']) || (data.isInProject is string && data.isInProject.size() <= 50))
        && (!data.keys().hasAny(['notInProjectStatus']) || (data.notInProjectStatus is string && data.notInProjectStatus.size() <= 200))
        && (!data.keys().hasAny(['attendancePreference']) || (data.attendancePreference is string && data.attendancePreference.size() <= 100))
        && (!data.keys().hasAny(['microtasksInterest']) || (data.microtasksInterest is string && data.microtasksInterest.size() <= 100))
        && (!data.keys().hasAny(['editAuthorized']) || data.editAuthorized is bool)
        && (!data.keys().hasAny(['editRequestStatus']) || data.editRequestStatus is string || data.editRequestStatus == null)
        && (!data.keys().hasAny(['editHistory']) || data.editHistory is list)
        && (!data.keys().hasAny(['lastEditedAt']) || data.lastEditedAt is number || data.lastEditedAt == null)
        && (!data.keys().hasAny(['lastEditedBy']) || (data.lastEditedBy is string && data.lastEditedBy.size() <= 255));
    }

    function isValidExtensionProject(data) {
      return data.keys().hasAll(['userId', 'authorEmail', 'title', 'coordinator', 'summary', 'justification', 'generalObjective', 'specificObjectives', 'methodology', 'targetAudience', 'expectedResults', 'createdAt', 'status'])
        && data.userId is string && data.userId.size() <= 128
        && data.authorEmail is string && data.authorEmail.size() <= 255
        && data.title is string && data.title.size() <= 500
        && data.coordinator is string && data.coordinator.size() <= 255
        && data.summary is string && data.summary.size() <= 10000
        && data.justification is string && data.justification.size() <= 15000
        && data.generalObjective is string && data.generalObjective.size() <= 5000
        && data.specificObjectives is string && data.specificObjectives.size() <= 10000
        && data.methodology is string && data.methodology.size() <= 15000
        && data.targetAudience is string && data.targetAudience.size() <= 5000
        && data.expectedResults is string && data.expectedResults.size() <= 10000
        && data.createdAt is number
        && data.status in ['enviada', 'em_analise', 'aprovada', 'rejeitada']
        && (!data.keys().hasAny(['institution', 'department', 'area', 'duration', 'location', 'sustainableDevelopmentGoal', 'keywords', 'schedule', 'team', 'references', 'budget', 'authorName', 'possibleCoordinators']) ||
          (!data.keys().hasAny(['institution']) || data.institution is string) &&
          (!data.keys().hasAny(['department']) || data.department is string) &&
          (!data.keys().hasAny(['area']) || data.area is string) &&
          (!data.keys().hasAny(['duration']) || data.duration is string) &&
          (!data.keys().hasAny(['location']) || data.location is string) &&
          (!data.keys().hasAny(['sustainableDevelopmentGoal']) || data.sustainableDevelopmentGoal is string) &&
          (!data.keys().hasAny(['keywords']) || data.keywords is string) &&
          (!data.keys().hasAny(['schedule']) || data.schedule is string) &&
          (!data.keys().hasAny(['team']) || data.team is string) &&
          (!data.keys().hasAny(['references']) || data.references is string) &&
          (!data.keys().hasAny(['budget']) || data.budget is string) &&
          (!data.keys().hasAny(['possibleCoordinators']) || data.possibleCoordinators is string) &&
          (!data.keys().hasAny(['authorName']) || data.authorName is string));
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'duration', 'date', 'createdAt'])
        && data.userId is string
        && data.title is string && data.title.size() <= 255
        && data.description is string && data.description.size() <= 2000
        && data.duration is string && data.duration.size() <= 100
        && data.date is string && data.date.size() <= 50
        && data.createdAt is number;
    }

    function isValidUser(data) {
      return (!data.keys().hasAny(['hasReceivedWelcomeEmail']) || data.hasReceivedWelcomeEmail is bool)
        && (!data.keys().hasAny(['lastEmailSentAt']) || data.lastEmailSentAt is number)
        && (!data.keys().hasAny(['lastEventEndDate']) || data.lastEventEndDate is number)
        && (!data.keys().hasAny(['theme']) || data.theme in ['light', 'dark'])
        && (!data.keys().hasAny(['isRH']) || data.isRH is bool)
        && (!data.keys().hasAny(['isDiretorio']) || data.isDiretorio is bool)
        && (!data.keys().hasAny(['leagueRole']) || (data.leagueRole is string && data.leagueRole.size() <= 255));
    }

    function isValidAdmin(data) {
       return data.keys().hasAll(['email'])
         && data.email is string && data.email.size() <= 255;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['performedByEmail', 'action', 'targetMemberName', 'timestamp'])
        && data.performedByEmail is string && data.performedByEmail.size() <= 255
        && (!data.keys().hasAny(['performedByName']) || (data.performedByName is string && data.performedByName.size() <= 255))
        && (!data.keys().hasAny(['performedByUid']) || (data.performedByUid is string && data.performedByUid.size() <= 128))
        && data.action is string && data.action.size() <= 100
        && (!data.keys().hasAny(['targetMemberId']) || (data.targetMemberId is string && data.targetMemberId.size() <= 128))
        && data.targetMemberName is string && data.targetMemberName.size() <= 255
        && (!data.keys().hasAny(['targetMemberEmail']) || (data.targetMemberEmail is string && data.targetMemberEmail.size() <= 255))
        && (!data.keys().hasAny(['details']) || (data.details is string && data.details.size() <= 4000))
        && (!data.keys().hasAny(['previousValue']) || (data.previousValue is string && data.previousValue.size() <= 4000))
        && (!data.keys().hasAny(['newValue']) || (data.newValue is string && data.newValue.size() <= 4000))
        && data.timestamp is number;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'status', 'engine', 'leader', 'createdAt'])
        && data.name is string && data.name.size() <= 255
        && data.status is string && data.status.size() <= 50
        && data.engine is string && data.engine.size() <= 100
        && data.leader is string && data.leader.size() <= 255
        && data.createdAt is number
        && (!data.keys().hasAny(['leaderUid']) || (data.leaderUid is string && data.leaderUid.size() <= 128))
        && (!data.keys().hasAny(['responsibleDirectorUid']) || (data.responsibleDirectorUid is string && data.responsibleDirectorUid.size() <= 128))
        && (!data.keys().hasAny(['teamMemberUids']) || (data.teamMemberUids is list && data.teamMemberUids.size() <= 100))
        && (!data.keys().hasAny(['boardsUrl']) || (data.boardsUrl is string && data.boardsUrl.size() <= 500))
        && (!data.keys().hasAny(['driveUrl']) || (data.driveUrl is string && data.driveUrl.size() <= 500));
    }

    function isValidInformalProject(data) {
      return data.keys().hasAll(['userId', 'authorName', 'title', 'description', 'status', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 255
        && data.title is string && data.title.size() <= 255
        && data.description is string && data.description.size() <= 5000
        && data.status in ['Ideia', 'Em desenvolvimento', 'Em testes', 'Publicado', 'Pausado']
        && data.createdAt is number
        && (!data.keys().hasAny(['authorEmail', 'genre', 'engine', 'repositoryUrl', 'demoUrl', 'teamMembers', 'technologies']) ||
          (!data.keys().hasAny(['authorEmail']) || data.authorEmail is string) &&
          (!data.keys().hasAny(['genre']) || data.genre is string) &&
          (!data.keys().hasAny(['engine']) || data.engine is string) &&
          (!data.keys().hasAny(['repositoryUrl']) || data.repositoryUrl is string) &&
          (!data.keys().hasAny(['demoUrl']) || data.demoUrl is string) &&
          (!data.keys().hasAny(['teamMembers']) || data.teamMembers is string) &&
          (!data.keys().hasAny(['technologies']) || data.technologies is string));
    }

    function isValidOpening(data) {
      return data.keys().hasAll(['role', 'projectId', 'projectName', 'description', 'status', 'openedAt'])
        && data.role is string && data.role.size() <= 255
        && data.projectId is string && data.projectId.size() <= 128
        && data.projectName is string && data.projectName.size() <= 255
        && data.description is string && data.description.size() <= 2000
        && data.status is string && data.status.size() <= 50
        && data.openedAt is number;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'projectName', 'area', 'deliverySpecs', 'status', 'createdAt'])
        && data.title is string && data.title.size() <= 255
        && data.projectName is string && data.projectName.size() <= 255
        && data.area is string && data.area.size() <= 100
        && data.deliverySpecs is string && data.deliverySpecs.size() <= 2000
        && data.status is string && data.status.size() <= 50
        && data.createdAt is number;
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['proposerName', 'proposerEmail', 'projectTitle', 'oneSentencePitch', 'status', 'createdAt'])
        && data.proposerName is string && data.proposerName.size() <= 255
        && data.proposerEmail is string && data.proposerEmail.size() <= 255
        && data.projectTitle is string && data.projectTitle.size() <= 255
        && data.oneSentencePitch is string && data.oneSentencePitch.size() <= 1000
        && data.status is string && data.status.size() <= 100
        && data.createdAt is number;
    }

    function isValidDoubt(data) {
      return data.keys().hasAll(['userId', 'authorName', 'authorEmail', 'title', 'description', 'status', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 255
        && data.authorEmail is string && data.authorEmail.size() <= 255
        && (!data.keys().hasAny(['authorDiscord']) || (data.authorDiscord is string && data.authorDiscord.size() <= 100))
        && (!data.keys().hasAny(['authorRole']) || (data.authorRole is string && data.authorRole.size() <= 255))
        && (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100))
        && data.title is string && data.title.size() <= 300
        && data.description is string && data.description.size() <= 5000
        && (!data.keys().hasAny(['priority']) || (data.priority is string && data.priority.size() <= 50))
        && data.status in ['pendente', 'em_analise', 'respondida']
        && (!data.keys().hasAny(['response']) || (data.response is string && data.response.size() <= 5000))
        && (!data.keys().hasAny(['answeredBy']) || (data.answeredBy is string && data.answeredBy.size() <= 255))
        && (!data.keys().hasAny(['answeredByRole']) || (data.answeredByRole is string && data.answeredByRole.size() <= 100))
        && (!data.keys().hasAny(['answeredAt']) || data.answeredAt is number)
        && data.createdAt is number;
    }

    // 4. Match Blocks
    match /responses/{responseId} {
      // Leitura global para administradores; membros comuns acessam apenas os próprios dados
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        ))
      );
      
      // Criação global para administradores; membros comuns criam apenas com seu próprio userId
      allow create: if isSignedIn()
        && isValidId(responseId)
        && (isAdmin() || incoming().userId == request.auth.uid)
        && isValidResponse(incoming());
        
      // Atualização global para administradores; membros comuns atualizam apenas o próprio registro
      allow update: if isSignedIn()
        && (
          isAdmin() || 
          (
            incoming().userId == request.auth.uid &&
            (existing().userId == request.auth.uid || (request.auth.token.email != null && existing().email != null && existing().email.lower() == request.auth.token.email.lower()))
          )
        )
        && isValidResponse(incoming());
        
      // Exclusão restrita exclusivamente a administradores
      allow delete: if isAdmin();
    }

    match /extensionProjects/{projectId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isSignedIn()
        && isValidId(projectId)
        && incoming().userId == request.auth.uid
        && isValidExtensionProject(incoming());
      allow update: if isAdmin() || (
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == request.auth.uid &&
        isValidExtensionProject(incoming())
      );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn(); // All authenticated users can view the calendar
      
      allow create: if isAdmin()
        && isValidId(eventId)
        && incoming().userId == request.auth.uid
        && isValidEvent(incoming());

      allow update: if isAdmin()
        && isValidEvent(incoming());
        
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming());
        
      allow update: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAuditLog(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'isadora.mlima@ufpe.br'
      );
    }

    function myEmailLower() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function canEditProjectId(projectId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isProjectOwner(get(/databases/$(database)/documents/projects/$(projectId)).data)
      );
    }

    // Aniversários para todos os membros: só nome, "DD/MM" e função. A diretoria atualiza a partir dos cadastros.
    match /birthdays/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['name', 'birthday', 'leagueRole', 'updatedAt'])
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().birthday is string && incoming().birthday.matches('^[0-9]{2}/[0-9]{2}$')
        && incoming().leagueRole is string && incoming().leagueRole.size() <= 200
        && incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    // Presença em eventos: o QR code leva o código; a presença só é aceita com o código certo.
    match /eventAttendanceCodes/{eventId} {
      allow read, write: if isAdmin();
    }
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && attendanceId == incoming().eventId + '_' + request.auth.uid
        && incoming().keys().hasOnly(['eventId', 'uid', 'email', 'name', 'eventTitle', 'eventDate', 'code', 'createdAt'])
        && incoming().uid == request.auth.uid
        && incoming().code is string
        && exists(/databases/$(database)/documents/eventAttendanceCodes/$(incoming().eventId))
        && get(/databases/$(database)/documents/eventAttendanceCodes/$(incoming().eventId)).data.code == incoming().code
        && incoming().name is string && incoming().name.size() <= 255
        && incoming().eventTitle is string && incoming().eventTitle.size() <= 255
        && incoming().eventDate is string && incoming().eventDate.size() <= 50
        && incoming().createdAt is number;
      allow delete: if isAdmin();
    }

    // Vitrine pública (#vitrine): só os campos públicos de cada jogo.
    match /showcase/{projectId} {
      allow read: if true;
      allow create, update: if canEditProjectId(projectId)
        && incoming().keys().hasOnly(['name', 'genre', 'engine', 'status', 'semester', 'pitch', 'cover', 'itchUrl', 'buildUrl', 'team', 'updatedAt'])
        && incoming().name is string && incoming().name.size() <= 255
        && incoming().pitch is string && incoming().pitch.size() <= 1500
        && incoming().cover is string && incoming().cover.size() <= 750000
        && incoming().team is list && incoming().team.size() <= 40
        && incoming().updatedAt is number;
      allow delete: if canEditProjectId(projectId);
    }

    // Playtests: o formulário abre sem login; as respostas só o time lê.
    match /playtests/{playtestId} {
      allow read: if true;
      allow create: if canManageProject(incoming().projectId)
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().questions is list && incoming().questions.size() <= 10
        && incoming().open is bool;
      allow update: if canManageProject(existing().projectId)
        && incoming().projectId == existing().projectId
        && existing().diff(incoming()).affectedKeys().hasOnly(['open']);
      allow delete: if canManageProject(existing().projectId);
    }
    match /playtestFeedback/{feedbackId} {
      allow read: if canManageProject(resource.data.projectId);
      allow create: if incoming().keys().hasOnly(['playtestId', 'projectId', 'testerName', 'rating', 'answers', 'createdAt'])
        && exists(/databases/$(database)/documents/playtests/$(incoming().playtestId))
        && get(/databases/$(database)/documents/playtests/$(incoming().playtestId)).data.open == true
        && get(/databases/$(database)/documents/playtests/$(incoming().playtestId)).data.projectId == incoming().projectId
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().answers is list && incoming().answers.size() <= 10
        && incoming().testerName is string && incoming().testerName.size() <= 120
        && incoming().createdAt is number;
    }

    // Game jams: a diretoria cria a jam; membros montam times; um voto por pessoa na votação.
    match /jams/{jamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /jamTeams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().ownerUid == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80
        && incoming().members is list && incoming().members.size() <= 10
        && incoming().memberEmails is list && incoming().memberEmails.size() <= 10;
      allow update: if isSignedIn()
        && incoming().ownerUid == existing().ownerUid
        && incoming().jamId == existing().jamId
        && incoming().memberEmails.size() <= 10
        && (
          isAdmin() || existing().ownerUid == request.auth.uid ||
          (existing().diff(incoming()).affectedKeys().hasOnly(['members', 'memberEmails']) && (
            incoming().memberEmails == existing().memberEmails.concat([myEmailLower()]) ||
            incoming().memberEmails == existing().memberEmails.removeAll([myEmailLower()])
          ))
        );
      allow delete: if isAdmin() || existing().ownerUid == request.auth.uid;
    }
    match /jamVotes/{voteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && voteId == incoming().jamId + '_' + request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().teamId is string
        && get(/databases/$(database)/documents/jams/$(incoming().jamId)).data.phase == 'votacao';
      allow delete: if isAdmin();
    }

    // Banco de recursos: qualquer membro compartilha; quem compartilhou ou a diretoria remove.
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().addedByUid == request.auth.uid
        && incoming().keys().hasOnly(['title', 'url', 'area', 'kind', 'description', 'addedBy', 'addedByUid', 'createdAt'])
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 160
        && incoming().url is string && incoming().url.size() <= 500 && incoming().url.matches('https?://.+')
        && incoming().description is string && incoming().description.size() <= 600
        && incoming().createdAt is number;
      allow delete: if isAdmin() || existing().addedByUid == request.auth.uid;
    }

    // Capa do projeto: imagem reduzida no navegador, guardada como data URL.
    // Todo membro vê; só admin, líder ou diretoria responsável trocam.
    match /projectCovers/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || (
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          isProjectOwner(get(/databases/$(database)/documents/projects/$(projectId)).data)
        ))
        && incoming().keys().hasOnly(['image', 'updatedAt', 'updatedBy'])
        && incoming().image is string
        && incoming().image.size() <= 750000
        && incoming().updatedAt is number
        && incoming().updatedBy is string && incoming().updatedBy.size() <= 255;
      allow delete: if isAdmin() || (
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isProjectOwner(get(/databases/$(database)/documents/projects/$(projectId)).data)
      );
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isRHorSuperAdmin()
        && isValidId(projectId)
        && isValidProject(incoming());
      allow update: if isAdmin() && isValidProject(incoming())
        || isProjectOwner(existing()) && isValidProject(incoming())
        || isProjectTeamMember(existing())
          && !isAdmin()
          && !isProjectOwner(existing())
          && existing().leaderUid == incoming().leaderUid
          && existing().responsibleDirectorUid == incoming().responsibleDirectorUid
          && existing().teamMemberUids == incoming().teamMemberUids
          && existing().diff(incoming()).affectedKeys().hasOnly([
            'gddUrl', 'gddDocumentId', 'scriptUrl', 'scriptDocumentId',
            'boardsUrl', 'repositoryUrl', 'buildUrl', 'itchUrl', 'driveUrl',
            'files', 'devlogs',
            'lastCheckInDate', 'lastCheckInNotes'
          ])
          && isValidProject(incoming());
      allow delete: if isRHorSuperAdmin();
    }

    match /informalProjects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(projectId)
        && incoming().userId == request.auth.uid
        && isValidInformalProject(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == request.auth.uid)
      ) && isValidInformalProject(incoming());
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /openings/{openingId} {
      allow read: if isSignedIn();
      allow create: if canManageProject(incoming().projectId)
        && isValidId(openingId)
        && isValidOpening(incoming());
      allow update: if isAdmin()
        && isValidOpening(incoming());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if canManageProject(incoming().projectId)
        && isValidId(taskId)
        && isValidTask(incoming());
      allow update: if isSignedIn()
        && isValidTask(incoming());
      allow delete: if isAdmin();
    }

    match /proposals/{proposalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.proposerEmail == request.auth.token.email);
      allow create: if isSignedIn()
        && isValidId(proposalId)
        && isValidProposal(incoming());
      allow update: if isAdmin()
        && isValidProposal(incoming());
      allow delete: if isAdmin();
    }

    match /doubts/{doubtId} {
      // Leitura global para administradores; membros comuns leem apenas suas próprias dúvidas
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.authorEmail != null && resource.data.authorEmail.lower() == request.auth.token.email.lower())
        ))
      );
      
      // Criação: administradores globalmente ou membros criando para si
      allow create: if isSignedIn()
        && isValidId(doubtId)
        && (isAdmin() || incoming().userId == request.auth.uid)
        && isValidDoubt(incoming());
        
      // Atualização: administradores podem responder/alterar; autor pode editar se pendente
      allow update: if isSignedIn()
        && (isAdmin() || (existing().userId == request.auth.uid && existing().status == 'pendente'))
        && isValidDoubt(incoming());
        
      // Exclusão: administradores globalmente ou autor da dúvida
      allow delete: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
    }
  }
}
